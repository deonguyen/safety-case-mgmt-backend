# Staging Dockerfile - Snapshot service
# Build context: repository root
#   docker build -f sq_spec_portal_backend_snapshot_project/Dockerfile.staging -t <tag> .

# ---------- Builder stage ----------
FROM python:3.13-slim AS builder

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    DJANGO_ENV=staging \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        libpq-dev \
        ca-certificates && \
    rm -rf /var/lib/apt/lists/*

RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

RUN pip install --upgrade pip && \
    pip install gunicorn python-dotenv psycopg2-binary boto3

COPY sq_spec_portal_backend_snapshot_project/requirements.txt /tmp/requirements.txt
RUN pip install -r /tmp/requirements.txt

RUN pip install --extra-index-url https://d41oosvkq9h6o.cloudfront.net sq-spec-portal-backend-core


# ---------- Runtime stage ----------
FROM python:3.13-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    DJANGO_ENV=staging \
    PATH="/opt/venv/bin:$PATH"

RUN apt-get update && apt-get install -y --no-install-recommends \
        libpq5 \
        ca-certificates && \
    update-ca-certificates && \
    rm -rf /var/lib/apt/lists/*

RUN groupadd --system app && useradd --system --gid app --home /usr/src/app app

WORKDIR /usr/src/app

COPY --from=builder /opt/venv /opt/venv

# COPY ./sq_spec_portal_backend_snapshot_project /usr/src/app/sq_spec_portal_backend_snapshot_project
COPY . .

# Keep only the staging environment file (if present)
# RUN rm -f .env.dev .env.staging .env.prod

# RUN chown -R app:app /usr/src/app
# USER app

EXPOSE 5014

# RUN ls -la /usr/src/app/sq_spec_portal_backend_snapshot_project
WORKDIR /usr/src/app/sq_spec_portal_backend_snapshot_project

CMD ["gunicorn", "sq_spec_portal_backend_snapshot_project.wsgi:application", "--bind", "0.0.0.0:5014"]
