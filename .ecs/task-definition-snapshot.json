{
  "family": "backend-snapshot-task-definition-stage",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "arn:aws:iam::673515369016:role/backend-task-execution-role-stage",
  "taskRoleArn": "arn:aws:iam::673515369016:role/backend-task-role-stage",
  "runtimePlatform": {
    "operatingSystemFamily": "LINUX",
    "cpuArchitecture": "X86_64"
  },
  "containerDefinitions": [
    {
      "name": "backend-snapshot-container-stage",
      "image": "673515369016.dkr.ecr.us-east-1.amazonaws.com/sq-spec-portal-backend-snapshot-repos-stage:stage",
      "essential": true,
      "cpu": 256,
      "memory": 512,
      "portMappings": [
        {
          "name": "snapshot-5014-tcp",
          "containerPort": 5014,
          "hostPort": 5014,
          "protocol": "tcp",
          "appProtocol": "http"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/sq-spec-portal-backend-snapshot-log-group-stage",
          "awslogs-region": "us-east-1",
          "awslogs-create-group": "true",
          "awslogs-stream-prefix": "backend-snapshot-container-stage"
        }
      },
      "healthCheck": {
        "command": [
          "CMD",
          "python",
          "-c",
          "import urllib.request; urllib.request.urlopen('http://127.0.0.1:5014/snapshot/health')"
        ],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 60
      }
    }
  ]
}
