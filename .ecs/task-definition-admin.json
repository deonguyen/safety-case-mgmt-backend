{
  "family": "backend-admin-task-definition-stage",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::673515369016:role/backend-task-execution-role-stage",
  "taskRoleArn": "arn:aws:iam::673515369016:role/backend-task-role-stage",
  "volumes": [
    {
      "name": "static-files"
    }
  ],
  "containerDefinitions": [
    {
      "name": "backend-admin-container-stage",
      "image": "673515369016.dkr.ecr.us-east-1.amazonaws.com/sq-spec-portal-backend-admin-repos-stage:stage",
      "essential": true,
      "cpu": 256,
      "memory": 512,
      "mountPoints": [
        {
          "sourceVolume": "static-files",
          "containerPath": "/usr/share/nginx/html/static"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/sq-spec-portal-backend-admin-log-group-stage",
          "awslogs-region": "us-east-1",
          "awslogs-create-group": "true",
          "awslogs-stream-prefix": "backend-admin-container-stage"
        }
      },
      "command": [
        "sh",
        "-c",
        "python manage.py collectstatic --noinput && gunicorn sq_spec_portal_backend_admin_project.wsgi:application --bind 0.0.0.0:5011"
      ],
      "portMappings": [
        {
          "name": "admin-5011-tcp",
          "containerPort": 5011,
          "hostPort": 5011,
          "protocol": "tcp"
        }
      ],
      "healthCheck": {
        "command": [
          "CMD",
          "python",
          "-c",
          "import urllib.request; urllib.request.urlopen('http://127.0.0.1:5011/admin/health')"
        ],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 60
      }
    },
    {
      "name": "backend-static-container-stage",
      "image": "673515369016.dkr.ecr.us-east-1.amazonaws.com/sq-spec-portal-backend-static-repos-stage:stage",
      "essential": true,
      "cpu": 256,
      "memory": 512,
      "mountPoints": [
        {
          "sourceVolume": "static-files",
          "containerPath": "/usr/share/nginx/html/static",
          "readOnly": true
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/sq-spec-portal-backend-admin-log-group-stage",
          "awslogs-region": "us-east-1",
          "awslogs-create-group": "true",
          "awslogs-stream-prefix": "backend-static-container-stage"
        }
      },
      "portMappings": [
        {
          "name": "admin-5080-tcp",
          "containerPort": 5080,
          "hostPort": 5080,
          "protocol": "tcp"
        }
      ],
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "wget --no-verbose --tries=1 --spider http://localhost:5080/health || exit 1"
        ],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 60
      }
    }
  ]
}
