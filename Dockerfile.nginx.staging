# Build context: repository root
#   docker build -f Dockerfile.nginx.staging -t <tag> .

# ---------- Builder stage (for collecting static files) ----------
FROM python:3.13-slim AS builder

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    DJANGO_ENV=staging

RUN apt-get update && apt-get install -y --no-install-recommends build-essential libpq-dev && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /usr/src/app

COPY sq_spec_portal_backend_admin_project/requirements.txt /tmp/requirements.txt
RUN pip install --upgrade pip && pip install -r /tmp/requirements.txt
RUN pip install --extra-index-url https://d41oosvkq9h6o.cloudfront.net sq-spec-portal-backend-core
 
# Copy only the necessary parts of the application for collectstatic
COPY sq_spec_portal_backend_admin_project /usr/src/app/sq_spec_portal_backend_admin_project
 
# Run collectstatic. The output will be in /usr/src/app/staticfiles, as defined by STATIC_ROOT
RUN python sq_spec_portal_backend_admin_project/manage.py collectstatic --noinput
 
 
# ---------- Final stage (Nginx) ----------
FROM nginx:alpine
 
# Copy the Nginx configuration file
COPY ./nginx.staging.conf /etc/nginx/conf.d/default.conf
 
# Copy the collected static files from the builder stage
COPY --from=builder /usr/share/nginx/html/static /usr/share/nginx/html/static

EXPOSE 5080

CMD ["nginx", "-g", "daemon off;"]
